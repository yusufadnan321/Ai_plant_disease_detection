{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/index.py",
      "framework": "fastapi",
      "runtime": "python",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "includeFiles": "{ai/artifacts/best_model.weights.h5,ai/artifacts/class_names.json,ai/trainingdataset/plant_disease_dataset.csv}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
